# Salin file ini menjadi .env lalu isi dengan nilai sebenarnya.
# JANGAN commit .env yang sudah terisi.

# --- SQL Server (salin dari application/config/database.php group default, repo CI internal) ---
DB_HOST=localhost
DB_PORT=1433
DB_USER=placeholder
DB_PASSWORD=isi-di-Portainer
DB_NAME=BMC

# --- Aplikasi ---
# APP_URL wajib HTTPS saat production; PUBLIC_APP_URL adalah URL yang dibuka user.
APP_URL=https://approval.internal
PUBLIC_APP_URL=http://10.19.25.29:3014

# Minimal 32 karakter. Dipakai menandatangani token approval.
TOKEN_SECRET=ganti-dengan-random-minimal-32-karakter

# Dipakai backend CodeIgniter saat memanggil createLink (header x-api-key).
API_KEY=ganti-dengan-kunci-acak

# Environment variables untuk aplikasi CodeIgniter lama.
MRP_APPROVAL_APP_URL=http://10.19.25.29:3014
MRP_APPROVAL_API_URL=http://10.19.25.29:3015
MRP_APPROVAL_API_KEY=sama-dengan-API_KEY
MRP_APPROVAL_LINK_SECRET=sama-dengan-TOKEN_SECRET

# Port container backend; host Portainer mempublish-nya sebagai 3015.
PORT=3015
NODE_ENV=production
ALLOW_UNSIGNED_LINK=false

# Data dummy tanpa database, untuk merapikan tampilan saja.
# WAJIB false di production (server menolak start kalau true).
DUMMY_MODE=false